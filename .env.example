# ============================================================
# Microsoft Graph (Outlook) — App Registration credentials
# ============================================================
# From Azure Portal → App Registrations → mail-triage-bot
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_SECRET=

# Where Microsoft will redirect after OAuth. Production:
# https://your-app.vercel.app/api/auth/outlook/callback
# Local dev: http://localhost:3000/api/auth/outlook/callback
MICROSOFT_REDIRECT_URI=

# ============================================================
# Google Gemini API
# ============================================================
# From aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Model to use. Free tier candidates:
# - gemini-2.5-flash-lite (cheapest, fastest)
# - gemini-2.5-flash (balanced)
# - gemini-2.5-pro (best quality, slower)
GEMINI_MODEL=gemini-2.5-flash

# ============================================================
# Telegram Bot
# ============================================================
# From @BotFather
TELEGRAM_BOT_TOKEN=

# Your personal chat ID (run `npm run get-chat-id` to find it)
TELEGRAM_CHAT_ID=

# ============================================================
# Upstash Redis (for token + state storage)
# ============================================================
# From console.upstash.com → your database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Internal — shared secret for cron endpoint authentication
# ============================================================
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Encryption key for storing refresh tokens (32 bytes hex)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
